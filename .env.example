# ====================================================================
# TripTales Environment Variables
# ====================================================================

# 1. Supabase (Cloud Database & Storage)
# Obtain from your Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Optional fallback keys for Next.js / Vercel compatibility
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# 2. Google Maps Platform (Optional)
# If provided, enables Google Maps Javascript SDK.
# If omitted, TripTales automatically uses the built-in Leaflet OpenStreetMap engine
# with direct Google Maps navigation links (100% free with zero API key required).
VITE_GOOGLE_MAPS_API_KEY=
